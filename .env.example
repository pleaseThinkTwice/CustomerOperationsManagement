# 复制为 .env 后按需修改。全部可选，不配置即用本地演示模式启动。
PORT=3000
# DATA_DIR=data

# —— 运营库（平台自有业务表） ——
# OPS_DB_DRIVER=sqlite            # sqlite | mysql
# OPS_DB_URL=mysql://user:pass@host:3306/cop_ops   # mysql 时需要 npm i mysql2

# —— 分析库（公司数仓，只读） ——
# ANALYTICS_DB_DRIVER=demo         # demo | mysql（Doris 走 MySQL 协议）
# ANALYTICS_DB_URL=mysql://user:pass@doris-fe:9030/test
# ANALYTICS_TABLE_PREFIX=test.     # 统一库名前缀；单表可用 ANALYTICS_TABLE_<逻辑表名>=库.表 覆盖

# 初始管理员密码（仅首次建库时生效）
# ADMIN_PASSWORD=admin123

# —— 大模型（由 src/ai 模块读取，OpenAI 兼容接口） ——
# LLM_BASE_URL=https://your-llm-gateway/v1
# LLM_API_KEY=
# LLM_MODEL=
